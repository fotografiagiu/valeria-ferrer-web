# Server-side only — never prefix with VITE_
# Copy to .env.local for local use (gitignored). Do NOT create Neon until confirmed.

# Neon Postgres connection string (production / preview)
DATABASE_URL=

# Optional separate URL for local/dev branch
# DATABASE_URL_DEV=

# Opaque secret for deriving session cookie integrity (≥32 random bytes)
SESSION_SECRET=

# Cookie name for staff session
STAFF_COOKIE_NAME=vf_staff_session

# Session lifetime in hours
STAFF_SESSION_TTL_HOURS=12

# Exact panel origin (CSRF / Origin checks on writes)
PANEL_ORIGIN=http://localhost:8787

# Comma-separated origins allowed to call GET /api/public/overrides
PUBLIC_WEB_ORIGINS=http://localhost:5173,https://www.valeriaferrer.com,https://valeriaferrer.com
