# Server-side only — never prefix with VITE_
# Copy to .env.local for local use (gitignored). Never commit secrets.

# Neon — runtime (pooled). Already injected by Vercel Neon integration.
DATABASE_URL=

# Neon — DDL / migrate / psql (direct). Prefer for npm run db:migrate.
DATABASE_URL_UNPOOLED=

# Optional separate URL for local/dev branch
# DATABASE_URL_DEV=

# Opaque secret for session cookie integrity (≥32 chars). Generate:
#   npm run env:session-secret
# Paste into Vercel Production + Preview (Sensitive). Do not commit.
SESSION_SECRET=

# Cookie name for staff session
STAFF_COOKIE_NAME=vf_staff_session

# Session lifetime in hours
STAFF_SESSION_TTL_HOURS=12

# Exact panel origin (CSRF / Origin checks on writes). No trailing slash.
# Local PWA (Vite): http://localhost:5173
# Production example: https://panel.valeriaferrer.com
PANEL_ORIGIN=http://localhost:5173

# Comma-separated origins allowed to call GET /api/public/overrides
PUBLIC_WEB_ORIGINS=http://localhost:5173,https://www.valeriaferrer.com,https://valeriaferrer.com

# --- Frontend (Vite) — safe to expose; never put DB secrets here ---
# Public site that hosts /chicas/* images (paths in DB stay unchanged).
VITE_PUBLIC_ASSET_ORIGIN=https://www.valeriaferrer.com
# Local API proxy target for Vite (optional)
# VITE_API_PROXY_TARGET=http://localhost:8787

# On Vercel Preview, staff CSRF also allows https://$VERCEL_URL and https://$VERCEL_BRANCH_URL
# (injected by the platform). No wildcard *.vercel.app.
