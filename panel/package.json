{
  "name": "valeria-ferrer-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "catalog:snapshot": "tsx scripts/catalog-snapshot.ts",
    "catalog:check": "tsx scripts/catalog-check.ts",
    "catalog:sync": "tsx scripts/catalog-sync.ts",
    "catalog:sync:dry": "tsx scripts/catalog-sync.ts --dry-run",
    "seed:overrides": "tsx scripts/seed-overrides.ts",
    "seed:overrides:dry": "tsx scripts/seed-overrides.ts --dry-run",
    "staff:create": "tsx scripts/create-staff-user.ts",
    "print:order": "tsx scripts/print-effective-order.ts",
    "pretest": "npm run catalog:snapshot",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "typecheck:api": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "verify": "npm run catalog:snapshot && npm run catalog:check && npm run typecheck",
    "env:check": "tsx scripts/env-check.ts",
    "env:session-secret": "tsx scripts/gen-session-secret.ts",
    "db:preflight": "tsx scripts/db-migrate.ts --preflight",
    "db:migrate": "tsx scripts/db-migrate.ts --apply",
    "db:migrate:promotion": "tsx scripts/db-migrate-promotion.ts",
    "dev:api": "tsx watch src/dev-server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "concurrently -k -n api,web -c gold,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:web",
    "db:migrate:staff-hidden": "tsx scripts/db-migrate-staff-hidden.ts",
    "db:migrate:gallery-paths": "tsx scripts/db-migrate-gallery-paths.ts",
    "smoke:promotion:server": "tsx scripts/smoke-promotion-server.ts",
    "smoke:promotion:api": "tsx scripts/smoke-promotion-api.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.14.3",
    "@neondatabase/serverless": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^12.0.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "~5.8.2",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
