# Public read-only overrides (no secrets). Used by production Vite builds.
VITE_PUBLIC_OVERRIDES_URL=https://valeria-ferrer-panel.vercel.app/api/public/overrides

# Public read-only web promotion state (Copas / Duples) from the staff panel.
VITE_PUBLIC_PROMOTION_URL=https://valeria-ferrer-panel.vercel.app/api/public/promotion

# Optional local proxy target for `npm run dev` (defaults to Production panel):
# VITE_OVERRIDES_PROXY_TARGET=https://valeria-ferrer-panel.vercel.app
# VITE_OVERRIDES_PROXY_TARGET=http://localhost:8787
